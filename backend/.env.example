# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/snapocr?retryWrites=true&w=majority

# JWT
JWT_SECRET=generate-a-secure-random-key
JWT_EXPIRY=30d

# CORS
CORS_ORIGIN=http://localhost:8081

# Mistral AI (OCR engine)
MISTRAL_API_KEY=your_mistral_api_key

# Apple Sign-In
SKIP_APPLE_VERIFICATION=true
APPLE_BUNDLE_ID=com.snapocr.app

# File Upload
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug
